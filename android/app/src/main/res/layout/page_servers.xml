<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/AhuraSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_servers" />

    <ListView
        android:id="@+id/serverList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:padding="6dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addServerButton"
                style="@style/AhuraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add" />

            <Button
                android:id="@+id/editServerButton"
                style="@style/AhuraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit" />

            <Button
                android:id="@+id/deleteServerButton"
                style="@style/AhuraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete" />

            <Button
                android:id="@+id/shareServerButton"
                style="@style/AhuraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_link" />

            <Button
                android:id="@+id/importServerButton"
                style="@style/AhuraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/import_clipboard" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
