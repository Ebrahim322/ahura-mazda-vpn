<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ahura" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/ahura_accent</item>
        <item name="android:colorPrimaryDark">@color/ahura_bg</item>
        <item name="android:colorAccent">@color/ahura_accent</item>
        <item name="android:windowBackground">@color/ahura_bg</item>
        <item name="android:textColorPrimary">@color/ahura_text</item>
        <item name="android:textColorSecondary">@color/ahura_muted</item>
        <item name="android:statusBarColor">@color/ahura_bg</item>
        <item name="android:navigationBarColor">@color/ahura_bg</item>
        <item name="android:colorControlActivated">@color/ahura_ok</item>
        <item name="android:colorControlNormal">@color/ahura_muted</item>
        <item name="android:colorButtonNormal">@color/ahura_surface_alt</item>
        <item name="android:colorBackgroundFloating">@color/ahura_surface</item>
    </style>

    <style name="AhuraCard">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="AhuraSection" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/ahura_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="AhuraLabel" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/ahura_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="AhuraMuted" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/ahura_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">2dp</item>
    </style>

    <style name="AhuraTab" parent="@android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:textColor">@color/ahura_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>

    <style name="AhuraButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">@color/ahura_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="AhuraPrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">#0B1020</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/button_primary_bg</item>
    </style>
</resources>
